# Azure OpenAI chat model (used by all agents and the LLM-judge evaluation scripts)
OPENAI_BASE_URL=https://<your-resource>.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_DEPLOYMENT_NAME=gpt-4.1
# Optional: leave unset to authenticate with Azure AD (DefaultAzureCredential / `az login`)
OPENAI_API_KEY=

# Azure OpenAI embeddings (must be text-embedding-ada-002 to match the precomputed DB)
AZURE_OPENAI_ENDPOINT_EMBEDDING=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY_EMBEDDING=
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# Firecrawl (only used when a paper URL is not already in data/all_final_csvs_finall/scraped_content.json)
FIRECRAWL_API_KEY=

# Set automatically by the runners per task; only needed when calling the DB tool directly
DB_PATH=
